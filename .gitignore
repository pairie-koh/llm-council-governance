# Experiment scratch logs (real result JSON in results_*/ dirs is committed
# deliberately; only logs and process stdio are ignored, at any depth)
experiments/*.log
experiments/*.err
experiments/**/*.log
experiments/**/run_stdout.log
experiments/**/run_stderr.log
experiments/**/auto_resume.log
experiments/scout_log*.txt
experiments/scout_err*.txt
experiments/smoke_log*.txt
experiments/council_types_run*.log
experiments/council_types_run*.err

# Crash artifacts (zero-filled checkpoints from power loss)
*.zeroed-crash

# LaTeX build artifacts (keep .tex, .pdf, .bbl, .bib, figures/)
paper/*.aux
paper/*.log
paper/*.out
paper/*.blg
paper/*.toc
paper/*.synctex.gz

# Experiment caches and throwaway result dirs
experiments/.cache/
experiments/results_*smoke*/
experiments/results_dryfire/

# Checkpoint backups
*.json.bak

